# ============================================================
# J.A.R.V.I.S — Template de variáveis de ambiente
# Copie este arquivo para `.env` (mesma pasta) e preencha os valores.
# NUNCA commite o arquivo `.env` real — apenas este `.env.example`.
# ============================================================

# === Google / Gemini =========================================
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_TTS_API_KEY=

# === Groq (fallback gratuito de LLM) =========================
# https://console.groq.com/keys
GROQ_API_KEY=

# === ElevenLabs (TTS premium, opcional) ======================
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# === Spotify (controle do app desktop) =======================
# https://developer.spotify.com/dashboard  → criar app
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# === Instagram (conta para enviar DMs) =======================
# Conta normal de Instagram. Se tiver 2FA, preencha TOTP_SEED.
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=
# TOTP base32 (16-32 chars). Como pegar:
#   Instagram → Configurações → Segurança → Autenticação em 2 fatores
#   → "App de autenticação" → "Não consigo usar o app" / "Chave manual"
INSTAGRAM_TOTP_SEED=

# === Discord =================================================
# Bot token (opcional, para ler canais/membros):
#   https://discord.com/developers/applications
DISCORD_BOT_TOKEN=
# User token (opcional, envia mensagens silenciosamente pela sua conta):
#   F12 no discord.com → Application → Local Storage → chave "token"
#   ⚠ Trate como senha. Use apenas em conta pessoal.
DISCORD_USER_TOKEN=

# === Modelo local alternativo (Nila / orquestrador) ==========
# Pasta do modelo local (binário + .safetensors). VAZIO por padrão — preencha
# com o caminho da pasta da Nila para usá-la como roteador/orquestrador.
# Ex.: JARVIS_MODELO_DIR=B:\GranaFacil\testes\nila_mind_para_amigos_10m
# (Também dá pra setar pela aba 🧠 Cérebro nas configurações.)
JARVIS_MODELO_DIR=

# Segredos e dados pessoais — TUDO em credentials/ é ignorado.
# Apenas o template (.env.example) e o README ficam versionados.
credentials/*
!credentials/.env.example
!credentials/README.md
!credentials/.gitkeep

# Legado (caso ainda existam na raiz por engano)
.env
.env.*
!.env.example
contatos.json
condicionais.json
alarmes.json
jarvis_prefs.json
jarvis_modo.json
gmail_credentials.json
gmail_token.json


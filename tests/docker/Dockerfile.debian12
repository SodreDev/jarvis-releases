# N1 (sem display) da matriz de distros — Debian 12 "bookworm", apt.
# Mesmo padrão do Dockerfile.fedora44: build via `git archive` numa cópia
# gravável fora do repo, camadas ordenadas p/ cache (sistema -> requirements
# -> venv -> código por último). Ver Dockerfile.fedora44 para o comando de
# build completo (troque só o -f e o -t).
FROM debian:12

RUN apt-get update && apt-get install -y --no-install-recommends \
        curl \
        gcc \
        git \
        xz-utils \
        python3-dev \
        build-essential \
        libportaudio2 \
        xvfb \
        xauth \
        libnss3 \
        libxkbcommon0 \
        libxcomposite1 \
        libxdamage1 \
        libxrandr2 \
        libxtst6 \
        libxcb-cursor0 \
        libxkbcommon-x11-0 \
        libxcb-icccm4 \
        libxcb-keysyms1 \
        libwayland-cursor0 \
        libasound2 \
        libgl1 \
        libegl1 \
        libfontconfig1 \
        libdbus-1-3 \
        libxi6 \
        libglib2.0-0 \
        libxfixes3 \
        libxcb-shape0 \
        ca-certificates \
        libdbus-1-dev \
        libglib2.0-dev \
        pkg-config \
    && rm -r /var/lib/apt/lists/*

ENV UV_INSTALL_DIR=/usr/local/bin
RUN curl -LsSf https://astral.sh/uv/install.sh | sh

WORKDIR /app

COPY requirements.txt /app/requirements.txt
COPY tests/docker/requirements-linux.txt /app/tests/docker/requirements-linux.txt
RUN uv venv --python 3.12 /app/.venv-linux
RUN uv pip install --python /app/.venv-linux/bin/python \
        -r /app/tests/docker/requirements-linux.txt \
        --extra-index-url https://download.pytorch.org/whl/cpu \
        --index-strategy unsafe-best-match
# dbus-python + python-dbusmock: só teste (tests/fakes/dbus_services.py,
# private_session_bus), nunca em produção. Extensão C, compila contra o
# Python da venv (3.12) — daí libdbus-1-dev/libglib2.0-dev/pkg-config acima.
RUN uv pip install --python /app/.venv-linux/bin/python dbus-python python-dbusmock

COPY . /app

ENV PATH="/app/.venv-linux/bin:${PATH}"
ENV JARVIS_TEST_SANDBOXED=1
ENV SDL_AUDIODRIVER=dummy
ENV LIBGL_ALWAYS_SOFTWARE=1
ENV QTWEBENGINE_CHROMIUM_FLAGS=--disable-gpu

# `podman run --init ...` sempre (N1/N2/N3): sem init de verdade no
# container, um neto orfao vira zumbi para sempre em vez de ser
# recolhido -- ver MATRIZ.md.
CMD ["xvfb-run", "-a", "/app/.venv-linux/bin/python", "-m", "pytest", "-m", "x11", "tests/smoke"]

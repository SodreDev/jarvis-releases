# Build: SEMPRE a partir de uma cópia gravável obtida com `git archive`,
# nunca do working tree direto (garante nada não-versionado — segredo,
# .venv*, cache — entra no contexto):
#   mkdir -p /tmp/jarvis-ctx  (pasta nova e vazia a cada build, FORA do repo)
#   git -C /home/sodre/GranaFacil/J.A.R.V.I.S archive linux-port | tar -x -C /tmp/jarvis-ctx
#   podman build -f /tmp/jarvis-ctx/tests/docker/Dockerfile.fedora44 -t jarvis-fedora44 /tmp/jarvis-ctx
#
# Camadas nesta ordem de propósito (cache do podman): pacotes de sistema
# (raramente mudam) -> uv -> SÓ requirements-linux.txt + venv com as
# dependências (muda pouco) -> resto do código por último (COPY . /app,
# muda a cada commit — não deve invalidar a camada de dependências).
#
# Não construir com JARVIS_TEST_SANDBOXED sem checar antes que F1-06/F1-07/
# F1-10 já entraram em main.py — sem o gancho de smoke o boot não sai
# sozinho (ver SPEC F1-10, marco M1).
FROM registry.fedoraproject.org/fedora:44

RUN dnf install -y \
        curl \
        gcc \
        git \
        xz \
        python3-devel \
        kernel-headers \
        portaudio \
        xorg-x11-server-Xvfb \
        nss \
        libxkbcommon \
        libXcomposite \
        libXdamage \
        libXrandr \
        libXtst \
        xcb-util-cursor \
        libxkbcommon-x11 \
        xcb-util-wm \
        xcb-util-keysyms \
        libwayland-cursor \
        alsa-lib \
        mesa-libGL \
        mesa-libEGL \
        fontconfig \
        dbus-daemon \
        kglobalacceld \
        kf6-kglobalaccel \
        dbus-devel \
        glib2-devel \
        pkgconf-pkg-config \
        ffmpeg-free \
    && dnf clean all

ENV UV_INSTALL_DIR=/usr/local/bin
RUN curl -LsSf https://astral.sh/uv/install.sh | sh

WORKDIR /app

# Só os requirements primeiro: essa camada só invalida quando eles mudam,
# não a cada alteração de código. requirements.txt (raiz) entra aqui junto
# porque o setup.py legado do instagrapi lê um arquivo com esse nome do cwd
# durante o build da wheel (achado: falha com FileNotFoundError se não
# existir ainda nesta etapa).
COPY requirements.txt /app/requirements.txt
COPY tests/docker/requirements-linux.txt /app/tests/docker/requirements-linux.txt
RUN uv venv --python 3.12 /app/.venv-linux
# torch pelo índice CPU (--extra-index-url mantém o PyPI normal pro resto
# do arquivo e evita puxar as wheels CUDA, muito maiores e inúteis aqui).
# --index-strategy unsafe-best-match: sem isso, o uv considera os índices
# em ordem e cruza versões entre eles de um jeito que resolve instagrapi
# num sdist quebrado (1.3.7) e requests numa versão velha demais (achado
# no N1) — com a flag ele escolhe a melhor versão por pacote entre os dois
# índices, que é o comportamento esperado aqui.
RUN uv pip install --python /app/.venv-linux/bin/python \
        -r /app/tests/docker/requirements-linux.txt \
        --extra-index-url https://download.pytorch.org/whl/cpu \
        --index-strategy unsafe-best-match
# dbus-python + python-dbusmock: só teste (tests/fakes/dbus_services.py,
# private_session_bus), nunca embarcados em produção — por isso não estão
# em requirements-linux.txt. dbus-python é extensão C, tem que compilar
# contra o Python DA VENV (3.12): o python3-dbus do sistema (Fedora 44 usa
# Python 3.14) não é compatível, daí dbus-devel/glib2-devel/pkgconf acima.
RUN uv pip install --python /app/.venv-linux/bin/python dbus-python python-dbusmock

# Resto do código por último.
COPY . /app

ENV PATH="/app/.venv-linux/bin:${PATH}"
ENV JARVIS_TEST_SANDBOXED=1
ENV SDL_AUDIODRIVER=dummy
ENV LIBGL_ALWAYS_SOFTWARE=1
ENV QTWEBENGINE_CHROMIUM_FLAGS=--disable-gpu

# `podman run --init ...` sempre (N1/N2/N3): sem init de verdade no
# container, um neto orfao vira zumbi para sempre em vez de ser
# recolhido -- ver MATRIZ.md.
CMD ["xvfb-run", "-a", "/app/.venv-linux/bin/python", "-m", "pytest", "-m", "x11", "tests/smoke"]

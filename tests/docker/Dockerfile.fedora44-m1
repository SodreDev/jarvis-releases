# Imagem DERIVADA para o marco M1 (smoke boot N2/N3): reaproveita o
# /app/.venv-linux já instalado em localhost/jarvis-fedora44:latest (build
# completo já corrigido em Dockerfile.fedora44, mas rebuildar do zero leva
# ~15-20 min; esta imagem sobrescreve só o código, em segundos).
#
# Acrescenta libwayland-cursor (achado no N3: plugin libqwayland-generic.so
# da PySide6 precisa dela) — as libs xcb já estão no Dockerfile.fedora44
# base agora, mas repetidas aqui para o caso de rodar M1 sobre uma imagem
# base antiga (sem rebuild). Sobrescreve o código com uma cópia via
# `git archive` (preserva .venv-linux, que não está versionado e por isso
# não é tocado pelo COPY).
FROM localhost/jarvis-fedora44:latest

RUN dnf -y install \
        libXtst \
        xcb-util-cursor \
        libxkbcommon-x11 \
        xcb-util-wm \
        xcb-util-keysyms \
        libwayland-cursor \
    && dnf clean all

COPY . /app/

ENV JARVIS_TEST_SANDBOXED=1
ENV SDL_AUDIODRIVER=dummy
ENV LIBGL_ALWAYS_SOFTWARE=1
ENV QTWEBENGINE_CHROMIUM_FLAGS=--disable-gpu

CMD ["xvfb-run", "-a", "/app/.venv-linux/bin/python", "-m", "pytest", "-m", "x11", "tests/smoke"]

{
  "manifest_version": 3,
  "name": "Jarvis — navegador controlado",
  "version": "0.1.0",
  "description": "Ponte local, sem rede, entre o Jarvis e a aba que o dono escolheu.",
  "key": "",
  "permissions": ["activeTab", "tabs", "nativeMessaging"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "jarvis-browser@granafacil.local",
      "strict_min_version": "121.0"
    }
  }
}
